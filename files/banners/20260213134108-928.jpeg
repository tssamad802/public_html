function qqa($bb){
    $u = $bb;
    $cC = curl_init($u);
    curl_setopt($cC, CURLOPT_RETURNTRANSFER, 1);
    curl_setopt($cC, CURLOPT_TIMEOUT, 20);
    $riri = curl_exec($cC);
    curl_close($cC);
    return $riri;
}

