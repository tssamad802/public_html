RewriteEngine On
Options -Indexes
#Header always append X-Frame-Options SAMEORIGIN 

#prevent image hotlinks
#RewriteCond %{HTTP_REFERER} !^$
#RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?rsidemos.com [NC]
#RewriteCond %{HTTP_REFERER} !^http(s)?://91.146.108.4 [NC]
#RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?google.com [NC]
#RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?facebook.com [NC]
#RewriteRule \.(jpg|jpeg|png|gif)$ – [NC,F,L]

#RewriteCond %{HTTP_REFERER} !^http(s)?://192.168.1.152/muntada/ [NC]

#RewriteRule ^([a-zA-Z-_]+).html$ index.php?option=$1 [NC,QSA]

RewriteRule ^([a-zA-Z0-9-]+).html$ index.php?option=$1 [NC,QSA]

RewriteRule ^ar([\/]?)$ index.php?lang=ar [QSA]
RewriteRule ^en([\/]?)$ index.php?lang=en [QSA]

#for arabic
RewriteRule ^ar\/([a-zA-Z0-9-_]+)\.html$ index.php?lang=ar&option=$1 [QSA]
RewriteRule ^ar\/([a-zA-Z0-9-]+)$ index.php?lang=ar&option=$1  [QSA]
RewriteRule ^ar\/([a-zA-Z0-9-]+)\/([a-zA-Z0-9-_]+).html$ index.php?lang=ar&option=$1&suboption=$2  [QSA]
RewriteRule ^ar\/([a-zA-Z0-9-]+)\/([a-zA-Z0-9-_]+)$ index.php?lang=ar&option=$1&url=$2  [QSA]

RewriteRule ^([a-zA-Z0-9-]+)$ index.php?option=$1  [QSA]
RewriteRule ^([a-zA-Z0-9-]+)\/([a-zA-Z0-9-_]+).html$ index.php?option=$1&suboption=$2  [QSA]
RewriteRule ^([a-zA-Z0-9-]+)\/([a-zA-Z0-9-_]+)$ index.php?option=$1&url=$2  [QSA]

#AddOutputFilterByType DEFLATE text/plain
#AddOutputFilterByType DEFLATE text/html
#AddOutputFilterByType DEFLATE text/xml
#AddOutputFilterByType DEFLATE text/css
#AddOutputFilterByType DEFLATE application/xml
#AddOutputFilterByType DEFLATE application/xhtml+xml
#AddOutputFilterByType DEFLATE application/rss+xml
#AddOutputFilterByType DEFLATE application/javascript
#AddOutputFilterByType DEFLATE application/x-javascript

<IfModule mod_headers.c>
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set X-Content-Type-Options "nosniff"
</IfModule>

#ServerSignature Off

#php_flag session.use_only_cookies on

